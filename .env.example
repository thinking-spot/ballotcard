# Supabase — get these from your project settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NextAuth — generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=your-secret-here
# Required in production (auto-detected in dev)
AUTH_URL=https://your-domain.com

# On-ingestion revalidation — the ingest script POSTs to /api/revalidate after
# a successful run so the ISR cache flushes immediately. Set both vars in the
# same environment as the script (Vercel + .env.local). SITE_URL is the public
# origin of the app; REVALIDATE_SECRET is a shared bearer token (use
# `openssl rand -hex 32`). Without either, ingestion runs and skips the flush.
SITE_URL=https://ballot-card.com
REVALIDATE_SECRET=replace-with-openssl-rand-hex-32

# Sentry — only needed in production; leave unset in .env.local for local dev
# Get DSN from: sentry.io > project > settings > client keys
NEXT_PUBLIC_SENTRY_DSN=https://xxx@ooo.ingest.sentry.io/nnn
# Used by Sentry Webpack plugin to upload source maps during CI build
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=ballotcard
SENTRY_AUTH_TOKEN=sntrys_your_token_here
